{
  "name": "cytoscape",
  "version": "3.34.0-unstable",
  "license": "MIT",
  "description": "Graph theory (a.k.a. network) library for analysis and visualisation",
  "homepage": "http://js.cytoscape.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/cytoscape/cytoscape.js.git"
  },
  "bugs": {
    "url": "https://github.com/cytoscape/cytoscape.js/issues"
  },
  "keywords": [
    "graph",
    "graph-theory",
    "network",
    "node",
    "edge",
    "vertex",
    "link",
    "analysis",
    "visualisation",
    "visualization",
    "draw",
    "render",
    "biojs",
    "cytoscape"
  ],
  "engines": {
    "node": ">=0.10"
  },
  "types": "index.d.ts",
  "main": "dist/cytoscape.cjs.js",
  "module": "dist/cytoscape.esm.mjs",
  "exports": {
    ".": {
      "import": "./dist/cytoscape.esm.mjs",
      "require": "./dist/cytoscape.cjs.js",
      "types": "./index.d.ts"
    },
    "./dist/cytoscape.esm.mjs": {
      "import": "./dist/cytoscape.esm.mjs"
    },
    "./dist/cytoscape.esm": {
      "import": "./dist/cytoscape.esm.mjs"
    },
    "./dist/cytoscape.esm.min.mjs": {
      "import": "./dist/cytoscape.esm.min.mjs"
    },
    "./dist/cytoscape.esm.min": {
      "import": "./dist/cytoscape.esm.min.mjs"
    },
    "./dist/cytoscape.cjs.js": {
      "require": "./dist/cytoscape.cjs.js"
    },
    "./dist/cytoscape.umd.js": {
      "require": "./dist/cytoscape.umd.js"
    },
    "./dist/cytoscape.min.js": {
      "require": "./dist/cytoscape.min.js"
    }
  },
  "unpkg": "dist/cytoscape.min.js",
  "jsdelivr": "dist/cytoscape.min.js",
  "scripts": {
    "lint": "eslint src/**/*.mjs",
    "build": "rollup -c",
    "build:esm": "FILE=esm rollup -c",
    "build:esm.min": "FILE=esm.min rollup -c",
    "build:cjs": "FILE=cjs rollup -c",
    "build:umd": "FILE=umd rollup -c",
    "build:min": "FILE=min rollup -c",
    "clean": "premove build",
    "copyright": "node license-update.mjs",
    "dist:copy": "mkdir -p dist && cp build/cytoscape.{umd.js,min.js,cjs.js,esm.mjs,esm.min.mjs} dist/",
    "dist": "NODE_ENV=production bun run --sequential build dist:copy",
    "release": "bun run --sequential copyright dist docs",
    "watch": "bun run --sequential watch:fast",
    "watch:sync": "livereload \"build, debug\" -w 500",
    "watch:http": "http-server -p 3333 -s -c -1 -o debug",
    "watch:fast": "run-p watch:sync watch:http watch:build:fast",
    "watch:umd": "run-p watch:sync watch:http watch:build:umd",
    "watch:build:fast": "FILE=umd SOURCEMAPS=true BABEL=false NODE_ENV=development rollup -c -w",
    "watch:build:umd": "FILE=umd SOURCEMAPS=true NODE_ENV=development rollup -c -w",
    "watch:build:cjs": "FILE=cjs SOURCEMAPS=true NODE_ENV=development rollup -c -w",
    "test": "bun run --sequential test:js test:modules test:playwright lint",
    "test:js": "mocha  --recursive",
    "test:js:debug": "mocha inspect  --recursive",
    "test:build": "TEST_BUILD=true mocha",
    "test:modules": "mocha  test/modules",
    "test:modules:debug": "mocha inspect  test/modules",
    "test:playwright:http": "http-server -p 3333 -s -c -1",
    "test:playwright:build": "FILE=umd SOURCEMAPS=true BABEL=false NODE_ENV=development rollup -c",
    "test:playwright:setup": "bun run --sequential test:playwright:build test:playwright:http",
    "test:playwright": "playwright test",
    "docs": "bun run --sequential docs:build docs:js",
    "docs:js": "mkdir -p documentation/js && cp build/cytoscape.min.js documentation/js/",
    "docs:build": "node documentation/docmaker.mjs",
    "docs:push": "gh-pages -d documentation",
    "benchmark": "bun run --sequential benchmark:all",
    "benchmark:download": "download https://raw.githubusercontent.com/cytoscape/cytoscape.js/master/dist/cytoscape.cjs.js --out build --filename cytoscape.benchmark.js",
    "benchmark:all:exec": "node benchmark/all",
    "benchmark:all": "bun run --sequential benchmark:download benchmark:all:exec",
    "benchmark:single:exec": "node benchmark/single",
    "benchmark:single": "bun run --sequential benchmark:download benchmark:single:exec"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.10.7",
    "benchmark": "^2.1.4",
    "bluebird": "^3.5.0",
    "chai": "^5.1.2",
    "download-cli": "^1.0.5",
    "eslint": "^9.18.0",
    "gh-pages": "^5.0.0",
    "gl-matrix": "^3.4.3",
    "globals": "^15.14.0",
    "handlebars": "^4.7.6",
    "heap": "^0.2.7",
    "highlight.js": "^10.0.0",
    "http-server": "^14.1.1",
    "jsonlint": "^1.6.2",
    "livereload": "^0.9.1",
    "lodash": "^4.17.21",
    "marked": "^4.0.10",
    "mocha": "^11.1.0",
    "premove": "^4.0.0",
    "rollup": "^4.31.0",
    "rollup-plugin-license": "^3.5.3"
  }
}
